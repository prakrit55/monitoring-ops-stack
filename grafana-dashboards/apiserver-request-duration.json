        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(apiserver_request_duration_seconds_bucket{verb=~\"$verb\", resource=~\"$resource\", instance=~\"$instance\"}[$__rate_interval])) by (le))",
          "legendFormat": "Overall p99 Latency",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "API Server p99 Latency (apiserver_request_duration_seconds)",
      "type": "stat",
      "description": "Response time percentiles. Spikes indicate downstream bottlenecks or resource starvation."
