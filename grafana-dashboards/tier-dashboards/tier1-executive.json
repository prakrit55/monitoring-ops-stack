  "description": "Tier 1: Executive & NOC Overview Dashboard for high-level platform health, 30-day SLO error budgets, burn rates, critical journey status, and aggregate traffic breakdown.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
