      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "rate(node_disk_weighted_io_time_seconds_total{instance=~\"$instance\", device!~\"loop.*|ram.*\"}[5m]) or (rate(node_disk_weighted_io_time_ms_total{instance=~\"$instance\", device!~\"loop.*|ram.*\"}[5m]) / 1000)",
          "legendFormat": "{{device}} Queue Depth",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Disk Weighted I/O / Queue Depth (Saturation)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Network Errors: Packet drops and hardware transmission/reception errors on physical/virtual interfaces.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Packets / Sec",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "decimals": 1,
          "mappings": [],
          "unit": "pps"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*Drop.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#EAB839", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*Error.*" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 9,
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_network_receive_drop_total{instance=~\"$instance\", device!~\"lo|veth.*|docker.*\"}[5m]))",
          "legendFormat": "{{device}} Rx Drops",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_network_transmit_drop_total{instance=~\"$instance\", device!~\"lo|veth.*|docker.*\"}[5m]))",
          "legendFormat": "{{device}} Tx Drops",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_network_receive_errs_total{instance=~\"$instance\", device!~\"lo|veth.*|docker.*\"}[5m]))",
          "legendFormat": "{{device}} Rx Errors",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (device) (rate(node_network_transmit_errs_total{instance=~\"$instance\", device!~\"lo|veth.*|docker.*\"}[5m]))",
          "legendFormat": "{{device}} Tx Errors",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Network Drops & Packet Errors (Errors)",
      "type": "timeseries"
    }
