        "type": "query"
      },
      {
        "current": { "selected": false, "text": "service-a", "value": "service-a" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(http_requests_total{namespace=~\"$namespace\"}, service)",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "service",
        "options": [],
        "query": { "query": "label_values(http_requests_total{namespace=~\"$namespace\"}, service)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "15s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "30m", "1h", "3h", "6h", "12h", "24h"]
  },
  "timezone": "browser",
  "title": "Tier 2: Service Health (RED)",
  "uid": "tier2-red-service",
