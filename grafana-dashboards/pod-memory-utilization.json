              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "namespace 1": true,
              "namespace 2": true,
              "namespace 3": true
            },
            "indexByName": {},
            "renameByName": {
              "Value #Limits": "Memory Limit",
              "Value #Requests": "Memory Request",
              "Value #Usage": "Current Working Set",
              "namespace": "Namespace",
              "pod": "Pod Name"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Working Set % of Limit",
            "binary": {
              "left": "Current Working Set",
              "operator": "/",
              "reducer": "sum",
              "right": "Memory Limit"
            },
            "mode": "binary"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Working Set % of Limit",
            "binary": {
              "left": "Working Set % of Limit",
