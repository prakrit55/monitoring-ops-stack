        "cellHeight": "sm",
        "footer": {
          "countRows": true,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Current CPU Usage (Cores)"
          }
        ]
      },
      "pluginVersion": "10.4.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace, pod) (rate(pod_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]) or rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}[$__rate_interval]))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "Usage"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace, pod) (kube_pod_container_resource_requests{resource=\"cpu\", namespace=~\"$namespace\", pod=~\"$pod\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "Requests"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (namespace, pod) (kube_pod_container_resource_limits{resource=\"cpu\", namespace=~\"$namespace\", pod=~\"$pod\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "Limits"
        }
      ],
      "title": "Pod CPU Resource Utilization Table (Usage vs Requests vs Limits)",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "pod",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "namespace 1": true,
              "namespace 2": true,
              "namespace 3": true
            },
            "indexByName": {},
            "renameByName": {
              "Value #Limits": "CPU Limit (Cores)",
              "Value #Requests": "CPU Request (Cores)",
              "Value #Usage": "Current CPU Usage (Cores)",
              "namespace": "Namespace",
              "pod": "Pod Name"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Usage % of Limit",
            "binary": {
              "left": "Current CPU Usage (Cores)",
              "operator": "/",
              "reducer": "sum",
              "right": "CPU Limit (Cores)"
            },
            "mode": "binary"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Usage % of Limit",
            "binary": {
              "left": "Usage % of Limit",
